# Copy to .env for local development. Do not commit real passwords or keys.
# Released calendarBuddy version that production runs (docker-compose.yml pulls
# ghcr.io/rtcryo/calendarbuddy-<component>:<version>). Required. Updated by release-please.
CALENDARBUDDY_VERSION=1.0.0 # x-release-please-version
POSTGRES_DB=calendarbuddy
POSTGRES_USER=calendarbuddy
POSTGRES_PASSWORD=change-me
AUTH_JWKS_URI=http://auth:8080/.well-known/jwks.json
AUTH_ISSUER=homebuddy-auth
AUTH_AUDIENCE=calendarbuddy
CALENDAR_DOMAIN=calendar.example.com
TRAEFIK_ACME_EMAIL=ops@example.com
