<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">
    <changeSet id="002-create-family-members" author="calendar-api">
        <createTable tableName="family_members">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="account_id" type="UUID"><constraints nullable="false"/></column>
            <column name="name" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="color" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
        <addForeignKeyConstraint baseTableName="family_members" baseColumnNames="account_id"
                                 referencedTableName="accounts" referencedColumnNames="id"
                                 constraintName="fk_family_members_account" onDelete="CASCADE"/>
        <sql>CREATE UNIQUE INDEX uk_family_members_account_name_ci ON family_members(account_id, lower(name))</sql>
        <sql>ALTER TABLE family_members ADD CONSTRAINT ck_family_members_color CHECK (color IN ('indigo','teal','coral','rose','amber','sky','violet','slate'))</sql>
        <rollback><dropTable tableName="family_members"/></rollback>
    </changeSet>
</databaseChangeLog>
